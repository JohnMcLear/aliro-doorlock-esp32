+// Commissioning debug helper, added 2026-09-21.
+//
+// A failed commissioning attempt leaves the window shut, so every retry needed a
+// power cycle, which is miserable in someone else's house. Reopen it, and say so.
+static void aliro_debug_reopen_window(const char *why)
+{
+    if (chip::Server::GetInstance().GetFabricTable().FabricCount() > 0) {
+        ESP_LOGW(TAG, "DEBUG: not reopening the commissioning window after %s: already commissioned", why);
+        return;
+    }
+    chip::DeviceLayer::PlatformMgr().ScheduleWork([](intptr_t) {
+        auto &mgr = chip::Server::GetInstance().GetCommissioningWindowManager();
+        if (mgr.IsCommissioningWindowOpen()) {
+            return;
+        }
+        const CHIP_ERROR err = mgr.OpenBasicCommissioningWindow(mgr.MaxCommissioningTimeout());
+        if (err == CHIP_NO_ERROR) {
+            ESP_LOGW(TAG, "DEBUG: commissioning window reopened, scan again without a power cycle");
+        } else {
+            ESP_LOGE(TAG, "DEBUG: could not reopen the commissioning window: %" CHIP_ERROR_FORMAT, err.Format());
+        }
+    });
+    ESP_LOGW(TAG, "DEBUG: reopening the commissioning window after %s", why);
+}
