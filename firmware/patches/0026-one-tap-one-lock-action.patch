         m5nfc_update();
         m5nfc_activation_result_t activation = m5nfc_activate();
         if (activation == M5NFC_ACTIVATION_NONE) {
+            if (g_tap_latched && esp_timer_get_time() - g_tap_last_seen_us >= kTapFieldClearUs) {
+                g_tap_latched = false;
+                ESP_LOGI("Aliro", "Field clear; the next tap is accepted");
+            }
+            vTaskDelay(pdMS_TO_TICKS(100));
+            continue;
