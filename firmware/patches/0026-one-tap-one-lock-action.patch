+// One tap = one lock action.
+//
+// A phone held on the reader re-authenticates every ~200 ms: measured 6 unlocks in
+// 1.2 s, each driving the lock output and sending ReportData to both Apple fabrics
+// (and with the tap toggle of patch 0007, flipping the lock back and forth). After a
+// successful transaction the reader latches: nothing in the field is processed again
+// until the field has been empty for kTapFieldClearUs. A second deliberate tap
+// therefore needs the phone or card lifted away for about a second, which is how
+// people tap anyway. The latch is per field, not per credential: the session handle
+// does not expose which credential answered, and a different person cannot be in the
+// field at the same instant as the first.
+constexpr int64_t kTapFieldClearUs = 1000 * 1000;
+static bool g_tap_latched = false;
+static int64_t g_tap_last_seen_us = 0;
+
 void AliroDoorLockDelegate::NfcDetectTask(void *delegate)
 {
     AliroDoorLockDelegate *doorLockDelegate = (AliroDoorLockDelegate *)delegate;
