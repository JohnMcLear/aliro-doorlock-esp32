+// Ring applet test mode (patch 0027). See aliro_ring_test.h and
+// docs/ring-applet-test-mode.md in the aliro-doorlock-esp32 repository.
+//
+// Everything printed here starts with "RING" so it can be grepped out of a
+// log that also carries Matter and driver output.
+
+#include "aliro_ring_test.h"
+
+#if CONFIG_ALIRO_RING_TEST_MODE
+
+#include <esp_aliro_utils.h>
+#include <esp_log.h>
+#include <esp_random.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <mbedtls/ecp.h>
+#include <nvs.h>
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if __has_include(<st25r300_nfc.h>)
+#include <st25r300_nfc.h>
+#define RING_HAVE_ST25R300 1
+#else
+#define RING_HAVE_ST25R300 0
+#endif
+
+#include "aliro_door_lock_delegate.h"
+
+namespace {
+
+constexpr char kTag[] = "ring_test";
+
+// NVS names are capped at 15 characters; a longer namespace silently reads as
+// "never stored" (UltraWideLock lesson 2.4).
+constexpr char kNvsNamespace[] = "aliro_ring";
+constexpr char kKeyPriv[] = "priv";
+constexpr char kKeyGroup[] = "group";
+constexpr char kKeyEndpoints[] = "endpoints";
+constexpr char kKeyTrust[] = "trust";
+constexpr char kKeyBudget[] = "budget";
+constexpr char kKeyFwt[] = "fwt";
+constexpr char kKeyWtxCap[] = "wtxcap";
+constexpr char kKeyAttempts[] = "attempts";
+constexpr char kKeyApduTrace[] = "apdutrace";
+constexpr char kKeyFrameTrace[] = "frametrace";
+static_assert(sizeof(kNvsNamespace) - 1 <= 15, "NVS namespace too long");
+static_assert(sizeof(kKeyFrameTrace) - 1 <= 15, "NVS key too long");
+
+constexpr size_t kPrivLen = 32;
+constexpr size_t kPubLen = 65;
+constexpr size_t kGroupLen = 16;
+constexpr size_t kMaxEndpoints = 8;
+constexpr size_t kKeySlotMax = 16;
+constexpr size_t kPemMax = 256;
+constexpr size_t kMaxSteps = 24;
+
+struct Endpoint {
+    uint8_t pub[kPubLen];
+    uint8_t slot[kKeySlotMax];
+    size_t slot_len;
+};
+
+struct StoredEndpoints {
+    uint32_t count;
+    uint8_t pub[kMaxEndpoints][kPubLen];
+};
+
+enum class Trust : uint8_t {
+    kList = 0,  // only endpoint keys loaded here are accepted (key-slot lookup)
+    kAny = 1,   // no lookup registered; esp-aliro is left to its own devices
+};
+
+struct Step {
+    char name[16];
+    uint8_t cla;
+    uint8_t ins;
+    uint32_t ms;
+    size_t command_len;
+    size_t response_len;
+    uint16_t sw;
+    esp_err_t err;
+    uint32_t wtx;
+    bool budget_exceeded;
+    bool wtx_limit;
+    const char *last_frame;
+};
+
+SemaphoreHandle_t g_mutex = nullptr;  // guards g_endpoints and g_trust
+Endpoint g_endpoints[kMaxEndpoints];
+size_t g_endpoint_count = 0;
+Trust g_trust = Trust::kList;
+bool g_apdu_trace = false;
+
+// Session state, owned by the NFC task.
+int64_t g_session_start_us = 0;
+Step g_steps[kMaxSteps];
+size_t g_step_count = 0;
+size_t g_steps_dropped = 0;
+const char *g_transaction_type = "unknown";
+
+class Lock {
+public:
+    Lock() { xSemaphoreTake(g_mutex, portMAX_DELAY); }
+    ~Lock() { xSemaphoreGive(g_mutex); }
+};
+
+// ---------------------------------------------------------------------------
+// Small helpers
+
+void PrintHexLine(const char *prefix, const uint8_t *data, size_t len)
+{
+    printf("%s", prefix);
+    for (size_t i = 0; i < len; ++i) {
+        printf("%02X", data[i]);
+    }
+    printf("\n");
+}
+
+void PrintHexDump(const char *prefix, const uint8_t *data, size_t len)
+{
+    for (size_t offset = 0; offset < len; offset += 32) {
+        const size_t chunk = len - offset < 32 ? len - offset : 32;
+        printf("%s%s", prefix, offset ? "+ " : "");
+        for (size_t i = 0; i < chunk; ++i) {
+            printf("%02X ", data[offset + i]);
+        }
+        printf("\n");
+    }
+    fflush(stdout);
+}
+
+bool ParseHex(const char *text, uint8_t *out, size_t out_len)
+{
+    if (!text || strlen(text) != out_len * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < out_len; ++i) {
+        unsigned value = 0;
+        for (int nibble = 0; nibble < 2; ++nibble) {
+            const char c = text[i * 2 + nibble];
+            unsigned v;
+            if (c >= '0' && c <= '9') {
+                v = static_cast<unsigned>(c - '0');
+            } else if (c >= 'a' && c <= 'f') {
+                v = static_cast<unsigned>(c - 'a' + 10);
+            } else if (c >= 'A' && c <= 'F') {
+                v = static_cast<unsigned>(c - 'A' + 10);
+            } else {
+                return false;
+            }
+            value = (value << 4) | v;
+        }
+        out[i] = static_cast<uint8_t>(value);
+    }
+    return true;
+}
+
+bool ParseU32(const char *text, uint32_t min, uint32_t max, uint32_t &out)
+{
+    if (!text || !*text) {
+        return false;
+    }
+    char *end = nullptr;
+    const unsigned long value = strtoul(text, &end, 10);
+    if (*end != '\0' || value < min || value > max) {
+        return false;
+    }
+    out = static_cast<uint32_t>(value);
+    return true;
+}
+
+int RingRng(void *, unsigned char *buf, size_t len)
+{
+    esp_fill_random(buf, len);
+    return 0;
+}
+
+// Reader public key from its private key, P-256, uncompressed (04 || X || Y).
+bool DerivePublicKey(const uint8_t priv[kPrivLen], uint8_t pub[kPubLen])
+{
+    mbedtls_ecp_group grp;
+    mbedtls_ecp_point q;
+    mbedtls_mpi d;
+    mbedtls_ecp_group_init(&grp);
+    mbedtls_ecp_point_init(&q);
+    mbedtls_mpi_init(&d);
+    size_t olen = 0;
+    const bool ok = mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256R1) == 0 &&
+        mbedtls_mpi_read_binary(&d, priv, kPrivLen) == 0 && mbedtls_ecp_check_privkey(&grp, &d) == 0 &&
+        mbedtls_ecp_mul(&grp, &q, &d, &grp.G, RingRng, nullptr) == 0 &&
+        mbedtls_ecp_point_write_binary(&grp, &q, MBEDTLS_ECP_PF_UNCOMPRESSED, &olen, pub, kPubLen) == 0 &&
+        olen == kPubLen;
+    mbedtls_mpi_free(&d);
+    mbedtls_ecp_point_free(&q);
+    mbedtls_ecp_group_free(&grp);
+    return ok;
+}
+
+bool IsValidPublicKey(const uint8_t pub[kPubLen])
+{
+    mbedtls_ecp_group grp;
+    mbedtls_ecp_point q;
+    mbedtls_ecp_group_init(&grp);
+    mbedtls_ecp_point_init(&q);
+    const bool ok = pub[0] == 0x04 && mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256R1) == 0 &&
+        mbedtls_ecp_point_read_binary(&grp, &q, pub, kPubLen) == 0 && mbedtls_ecp_check_pubkey(&grp, &q) == 0;
+    mbedtls_ecp_point_free(&q);
+    mbedtls_ecp_group_free(&grp);
+    return ok;
+}
+
+// esp-aliro's PEM for a raw public key, NUL terminated. Returns the length the
+// library reported, which is what its own parser expects back.
+bool PemFromRaw(const uint8_t pub[kPubLen], char *pem, size_t pem_capacity, size_t &pem_len)
+{
+    pem_len = pem_capacity - 1;
+    if (esp_aliro_get_pubkey_pem_from_raw_data(pub, kPubLen, pem, &pem_len) != ESP_OK || pem_len >= pem_capacity) {
+        return false;
+    }
+    pem[pem_len] = '\0';
+    return true;
+}
+
+// The Aliro key slot esp-aliro derives for a credential public key. Tried with
+// and without the terminating NUL, because mbedTLS wants the NUL counted for
+// PEM input and the library's documentation does not say which it passes on.
+bool KeySlotFor(const uint8_t pub[kPubLen], uint8_t *slot, size_t &slot_len)
+{
+    char pem[kPemMax];
+    size_t pem_len = 0;
+    if (!PemFromRaw(pub, pem, sizeof(pem), pem_len)) {
+        return false;
+    }
+    const size_t text_len = strlen(pem);
+    const size_t candidates[2] = {text_len + 1, text_len};
+    for (size_t candidate : candidates) {
+        slot_len = kKeySlotMax;
+        if (esp_aliro_get_key_slot_from_cred_pubkey(pem, candidate, slot, &slot_len) == ESP_OK) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// ---------------------------------------------------------------------------
+// NVS
+
+esp_err_t NvsSetBlob(const char *key, const void *data, size_t len)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNvsNamespace, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = nvs_set_blob(handle, key, data, len);
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return err;
+}
+
+esp_err_t NvsGetBlob(const char *key, void *data, size_t len)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNvsNamespace, NVS_READONLY, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    size_t size = len;
+    err = nvs_get_blob(handle, key, data, &size);
+    nvs_close(handle);
+    if (err == ESP_OK && size != len) {
+        return ESP_ERR_INVALID_SIZE;
+    }
+    return err;
+}
+
+esp_err_t NvsSetU32(const char *key, uint32_t value)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNvsNamespace, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = nvs_set_u32(handle, key, value);
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return err;
+}
+
+bool NvsGetU32(const char *key, uint32_t &value)
+{
+    nvs_handle_t handle;
+    if (nvs_open(kNvsNamespace, NVS_READONLY, &handle) != ESP_OK) {
+        return false;
+    }
+    const bool ok = nvs_get_u32(handle, key, &value) == ESP_OK;
+    nvs_close(handle);
+    return ok;
+}
+
+esp_err_t NvsErase(const char *key)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNvsNamespace, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = nvs_erase_key(handle, key);
+    if (err == ESP_ERR_NVS_NOT_FOUND) {
+        err = ESP_OK;
+    }
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return err;
+}
+
+esp_err_t StoreEndpoints()
+{
+    StoredEndpoints stored = {};
+    {
+        Lock lock;
+        stored.count = static_cast<uint32_t>(g_endpoint_count);
+        for (size_t i = 0; i < g_endpoint_count; ++i) {
+            memcpy(stored.pub[i], g_endpoints[i].pub, kPubLen);
+        }
+    }
+    return NvsSetBlob(kKeyEndpoints, &stored, sizeof(stored));
+}
+
+void LoadEndpoints()
+{
+    StoredEndpoints stored = {};
+    if (NvsGetBlob(kKeyEndpoints, &stored, sizeof(stored)) != ESP_OK || stored.count > kMaxEndpoints) {
+        return;
+    }
+    Lock lock;
+    g_endpoint_count = 0;
+    for (size_t i = 0; i < stored.count; ++i) {
+        Endpoint &ep = g_endpoints[g_endpoint_count];
+        memcpy(ep.pub, stored.pub[i], kPubLen);
+        if (!KeySlotFor(ep.pub, ep.slot, ep.slot_len)) {
+            ESP_LOGW(kTag, "stored endpoint key %u has no key slot; skipped", static_cast<unsigned>(i));
+            continue;
+        }
+        ++g_endpoint_count;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Reader
+
+esp_err_t LookupCredentialPubkey(const uint8_t *key_slot, size_t key_slot_len, char *out_pubkey,
+                                 size_t *out_pubkey_len)
+{
+    PrintHexLine("RING key slot lookup: ", key_slot, key_slot_len);
+    uint8_t pub[kPubLen];
+    int found = -1;
+    {
+        Lock lock;
+        for (size_t i = 0; i < g_endpoint_count; ++i) {
+            if (g_endpoints[i].slot_len == key_slot_len && memcmp(g_endpoints[i].slot, key_slot, key_slot_len) == 0) {
+                memcpy(pub, g_endpoints[i].pub, kPubLen);
+                found = static_cast<int>(i);
+                break;
+            }
+        }
+    }
+    if (found < 0) {
+        printf("RING key slot lookup: NO MATCH among %u loaded endpoint key(s); credential rejected\n",
+               static_cast<unsigned>(g_endpoint_count));
+        fflush(stdout);
+        return ESP_ERR_NOT_FOUND;
+    }
+    char pem[kPemMax];
+    size_t pem_len = 0;
+    if (!out_pubkey || !out_pubkey_len || !PemFromRaw(pub, pem, sizeof(pem), pem_len) || pem_len >= *out_pubkey_len) {
+        printf("RING key slot lookup: matched endpoint %d but its PEM does not fit the library buffer\n", found);
+        return ESP_ERR_INVALID_SIZE;
+    }
+    memcpy(out_pubkey, pem, pem_len + 1);
+    *out_pubkey_len = pem_len;
+    printf("RING key slot lookup: matched endpoint %d\n", found);
+    fflush(stdout);
+    return ESP_OK;
+}
+
+// Apply a reader configuration the way a Matter administrator would, through
+// the delegate's own SetAliroReaderConfig, so the path under test is the one
+// a phone-provisioned reader uses. Clear first: Set refuses a configured reader.
+bool ApplyReader(const uint8_t priv[kPrivLen], const uint8_t group[kGroupLen])
+{
+    uint8_t pub[kPubLen];
+    if (!DerivePublicKey(priv, pub)) {
+        printf("RING ERROR reader private key is not a valid P-256 scalar\n");
+        return false;
+    }
+    AliroDoorLockDelegate &delegate = AliroDoorLockDelegate::Instance();
+    CHIP_ERROR err = delegate.ClearAliroReaderConfig();
+    if (err != CHIP_NO_ERROR) {
+        printf("RING ERROR could not clear the previous reader config: %" CHIP_ERROR_FORMAT "\n", err.Format());
+        return false;
+    }
+    err = delegate.SetAliroReaderConfig(ByteSpan(priv, kPrivLen), ByteSpan(pub, kPubLen), ByteSpan(group, kGroupLen),
+                                        chip::NullOptional);
+    if (err != CHIP_NO_ERROR) {
+        printf("RING ERROR SetAliroReaderConfig failed: %" CHIP_ERROR_FORMAT "\n", err.Format());
+        return false;
+    }
+    return true;
+}
+
+bool ReloadReader()
+{
+    uint8_t priv[kPrivLen];
+    uint8_t group[kGroupLen];
+    if (NvsGetBlob(kKeyPriv, priv, sizeof(priv)) != ESP_OK || NvsGetBlob(kKeyGroup, group, sizeof(group)) != ESP_OK) {
+        printf("RING no reader loaded with \"ring reader\"; endpoint and trust changes apply at the next boot\n");
+        return false;
+    }
+    const bool ok = ApplyReader(priv, group);
+    memset(priv, 0, sizeof(priv));
+    if (ok) {
+        printf("RING reader reloaded\n");
+    }
+    return ok;
+}
+
+void ShowReader()
+{
+    AliroDoorLockDelegate &delegate = AliroDoorLockDelegate::Instance();
+    uint8_t buf[kPubLen];
+    MutableByteSpan pub(buf);
+    if (delegate.GetAliroReaderVerificationKey(pub) != CHIP_NO_ERROR || pub.size() == 0) {
+        printf("RING reader: NOT CONFIGURED (use: ring reader <private key hex> <group id hex>)\n");
+        return;
+    }
+    PrintHexLine("RING reader public key      : ", pub.data(), pub.size());
+    uint8_t gbuf[16];
+    MutableByteSpan group(gbuf);
+    if (delegate.GetAliroReaderGroupIdentifier(group) == CHIP_NO_ERROR) {
+        PrintHexLine("RING reader group id        : ", group.data(), group.size());
+    }
+    uint8_t sbuf[16];
+    MutableByteSpan sub(sbuf);
+    if (delegate.GetAliroReaderGroupSubIdentifier(sub) == CHIP_NO_ERROR) {
+        PrintHexLine("RING reader group sub-id    : ", sub.data(), sub.size());
+    }
+    uint8_t priv[kPrivLen];
+    const bool via_ring = NvsGetBlob(kKeyPriv, priv, sizeof(priv)) == ESP_OK;
+    memset(priv, 0, sizeof(priv));
+    printf("RING reader keys loaded via : %s\n", via_ring ? "ring reader" : "Matter (or an earlier build)");
+}
+
+void ShowSettings()
+{
+    printf("RING ===== ring applet test mode: TEST KEYS ONLY, NOT FOR A REAL DOOR =====\n");
+    ShowReader();
+    {
+        Lock lock;
+        printf("RING trust mode             : %s\n",
+               g_trust == Trust::kList ? "list (only the endpoint keys below are accepted)"
+                                       : "any (no key-slot lookup registered)");
+        printf("RING endpoint keys          : %u of %u\n", static_cast<unsigned>(g_endpoint_count),
+               static_cast<unsigned>(kMaxEndpoints));
+        for (size_t i = 0; i < g_endpoint_count; ++i) {
+            printf("RING   [%u] key slot ", static_cast<unsigned>(i));
+            for (size_t j = 0; j < g_endpoints[i].slot_len; ++j) {
+                printf("%02X", g_endpoints[i].slot[j]);
+            }
+            printf(" public key ");
+            for (size_t j = 0; j < kPubLen; ++j) {
+                printf("%02X", g_endpoints[i].pub[j]);
+            }
+            printf("\n");
+        }
+    }
+#if RING_HAVE_ST25R300
+    printf("RING APDU budget            : %" PRIu32 " ms (ring budget <ms>)\n", st25r300_get_apdu_budget_ms());
+    printf("RING FWT floor              : %" PRIu32 " ms (ring fwt <ms>)\n", st25r300_get_fwt_floor_ms());
+    printf("RING WTX ceiling            : %" PRIu32 " ms (ring wtxcap <ms>)\n", st25r300_get_wtx_ceiling_ms());
+    printf("RING attempts per APDU      : %u (ring attempts <n>)\n", st25r300_get_apdu_attempts());
+    printf("RING frame trace            : %s\n", st25r300_get_frame_trace() ? "on" : "off");
+#endif
+    printf("RING APDU trace             : %s\n", g_apdu_trace ? "on" : "off");
+    fflush(stdout);
+}
