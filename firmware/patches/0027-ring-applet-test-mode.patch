+#pragma once
+
+// Ring applet test mode (patch 0027).
+//
+// Lets an Aliro credential developer run their applet against this reader
+// without a phone or a Matter commissioner: reader keys and credential
+// endpoint public keys are loaded over the USB serial console and kept in NVS,
+// every APDU is timed and can be traced in hex, and the NFC driver's slow-card
+// limits can be changed at run time. Built only with
+// CONFIG_ALIRO_RING_TEST_MODE=y. Keys loaded this way are TEST keys.
+
+#include <sdkconfig.h>
+
+#include <esp_aliro.h>
+#include <esp_err.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#if CONFIG_ALIRO_RING_TEST_MODE
+
+// Load the stored test settings and push the slow-card knobs into the NFC
+// driver. Call after m5nfc_init() and esp_aliro_init().
+void RingTestInit();
+
+// Called on every new reader handle, after esp_aliro_reader_create() and
+// before esp_aliro_reader_enable(): registers the endpoint key lookup when the
+// trust mode is "list".
+esp_err_t RingTestConfigureReader(esp_aliro_reader_handle_t reader);
+
+// One serial console line. Returns true when the line was a "ring" command
+// and has been handled.
+bool RingTestHandleLine(const char *line);
+
+// Transaction instrumentation, called from the NFC task.
+void RingTestSessionBegin();
+void RingTestBeforeExchange(const uint8_t *command, size_t command_len);
+void RingTestAfterExchange(const uint8_t *command, size_t command_len, const uint8_t *response,
+                           size_t response_len, esp_err_t err, int64_t elapsed_us);
+void RingTestNoteTransactionType(esp_aliro_session_handle_t session);
+void RingTestSessionEnd(esp_err_t err, const char *phase);
+
+#endif
