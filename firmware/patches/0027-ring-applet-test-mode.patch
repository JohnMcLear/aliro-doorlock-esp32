+
+void PersistDriverKnobs()
+{
+#if RING_HAVE_ST25R300
+    (void)NvsSetU32(kKeyBudget, st25r300_get_apdu_budget_ms());
+    (void)NvsSetU32(kKeyFwt, st25r300_get_fwt_floor_ms());
+    (void)NvsSetU32(kKeyWtxCap, st25r300_get_wtx_ceiling_ms());
+    (void)NvsSetU32(kKeyAttempts, st25r300_get_apdu_attempts());
+    (void)NvsSetU32(kKeyFrameTrace, st25r300_get_frame_trace() ? 1 : 0);
+#endif
+    (void)NvsSetU32(kKeyApduTrace, g_apdu_trace ? 1 : 0);
+}
+
+// ---------------------------------------------------------------------------
+// Steps
+
+// Step names by INS. The CLA and INS are always printed alongside, so a wrong
+// guess here is visible rather than misleading.
+const char *StepName(uint8_t cla, uint8_t ins)
+{
+    switch (ins) {
+    case 0xA4: return "SELECT";
+    case 0x80: return cla == 0x80 ? "AUTH0" : nullptr;
+    case 0x81: return cla == 0x80 ? "AUTH1" : nullptr;
+    case 0xD1: return "LOAD_CERT";
+    case 0xC9: return "EXCHANGE";
+    case 0x3C: return "CONTROL_FLOW";
+    case 0xC3: return "ENVELOPE";
+    case 0xC0: return "GET_RESPONSE";
+    default: return nullptr;
+    }
+}
+
+void FormatStepName(const uint8_t *command, size_t command_len, char *out, size_t out_size)
+{
+    const uint8_t cla = command_len > 0 ? command[0] : 0;
+    const uint8_t ins = command_len > 1 ? command[1] : 0;
+    const char *name = StepName(cla, ins);
+    if (name) {
+        snprintf(out, out_size, "%s", name);
+    } else {
+        snprintf(out, out_size, "INS_%02X", ins);
+    }
+}
+
+uint32_t SinceSessionMs()
+{
+    return static_cast<uint32_t>((esp_timer_get_time() - g_session_start_us) / 1000);
+}
+
+bool ParseOnOff(const char *text, bool &out)
+{
+    if (text && strcmp(text, "on") == 0) {
+        out = true;
+        return true;
+    }
+    if (text && strcmp(text, "off") == 0) {
+        out = false;
+        return true;
+    }
+    return false;
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// Public entry points
+
+void RingTestInit()
+{
+    if (!g_mutex) {
+        g_mutex = xSemaphoreCreateMutex();
+    }
+    LoadEndpoints();
+    uint32_t value = 0;
+    if (NvsGetU32(kKeyTrust, value)) {
+        g_trust = value == 1 ? Trust::kAny : Trust::kList;
+    }
+    if (NvsGetU32(kKeyApduTrace, value)) {
+        g_apdu_trace = value != 0;
+    }
+#if RING_HAVE_ST25R300
+    if (NvsGetU32(kKeyBudget, value)) {
+        st25r300_set_apdu_budget_ms(value);
+    }
+    if (NvsGetU32(kKeyFwt, value)) {
+        st25r300_set_fwt_floor_ms(value);
+    }
+    if (NvsGetU32(kKeyWtxCap, value)) {
+        st25r300_set_wtx_ceiling_ms(value);
+    }
+    if (NvsGetU32(kKeyAttempts, value)) {
+        st25r300_set_apdu_attempts(static_cast<uint8_t>(value));
+    }
+    if (NvsGetU32(kKeyFrameTrace, value)) {
+        st25r300_set_frame_trace(value != 0);
+    }
+#endif
+    ESP_LOGW(kTag, "RING TEST MODE ACTIVE: keys loaded over serial are TEST keys. Not for a real door. "
+                   "Type \"ring help\".");
+    ESP_LOGI(kTag, "%u endpoint key(s) loaded, trust mode %s", static_cast<unsigned>(g_endpoint_count),
+             g_trust == Trust::kList ? "list" : "any");
+}
+
+esp_err_t RingTestConfigureReader(esp_aliro_reader_handle_t reader)
+{
+    Trust trust;
+    size_t count;
+    {
+        Lock lock;
+        trust = g_trust;
+        count = g_endpoint_count;
+    }
+    if (trust == Trust::kAny) {
+        ESP_LOGW(kTag, "trust mode any: no key-slot lookup registered with esp-aliro");
+        return ESP_OK;
+    }
+    if (count == 0) {
+        ESP_LOGW(kTag, "trust mode list with no endpoint keys: every credential will be rejected at the lookup");
+    }
+    return esp_aliro_reader_enable_key_slot(reader, LookupCredentialPubkey);
+}
+
+bool RingTestHandleLine(const char *line)
+{
+    if (strncmp(line, "ring", 4) != 0 || (line[4] != '\0' && line[4] != ' ')) {
+        return false;
+    }
+    char buf[256];
+    snprintf(buf, sizeof(buf), "%s", line);
+    char *argv[6] = {};
+    int argc = 0;
+    for (char *save = nullptr, *tok = strtok_r(buf, " ", &save); tok && argc < 6; tok = strtok_r(nullptr, " ", &save)) {
+        argv[argc++] = tok;
+    }
+    const char *cmd = argc > 1 ? argv[1] : "help";
+
+    if (strcmp(cmd, "help") == 0) {
+        ShowHelp();
+    } else if (strcmp(cmd, "show") == 0) {
+        ShowSettings();
+    } else if (strcmp(cmd, "reader") == 0 && argc == 3 && strcmp(argv[2], "clear") == 0) {
+        const CHIP_ERROR err = AliroDoorLockDelegate::Instance().ClearAliroReaderConfig();
+        (void)NvsErase(kKeyPriv);
+        (void)NvsErase(kKeyGroup);
+        printf(err == CHIP_NO_ERROR ? "RING reader cleared\n" : "RING ERROR reader clear failed\n");
+    } else if (strcmp(cmd, "reader") == 0 && argc == 4) {
+        uint8_t priv[kPrivLen];
+        uint8_t group[kGroupLen];
+        if (!ParseHex(argv[2], priv, sizeof(priv)) || !ParseHex(argv[3], group, sizeof(group))) {
+            printf("RING ERROR usage: ring reader <private key, 64 hex> <group id, 32 hex>\n");
+        } else if (ApplyReader(priv, group)) {
+            const esp_err_t e1 = NvsSetBlob(kKeyPriv, priv, sizeof(priv));
+            const esp_err_t e2 = NvsSetBlob(kKeyGroup, group, sizeof(group));
+            printf("RING reader loaded (TEST KEYS)%s\n", e1 == ESP_OK && e2 == ESP_OK ? "" : ", but NVS save failed");
+            ShowReader();
+        }
+        memset(priv, 0, sizeof(priv));
+    } else if (strcmp(cmd, "endpoint") == 0 && argc == 4 && strcmp(argv[2], "add") == 0) {
+        Endpoint ep = {};
+        if (!ParseHex(argv[3], ep.pub, kPubLen) || !IsValidPublicKey(ep.pub)) {
+            printf("RING ERROR usage: ring endpoint add <uncompressed P-256 public key, 130 hex starting 04>\n");
+        } else if (!KeySlotFor(ep.pub, ep.slot, ep.slot_len)) {
+            printf("RING ERROR esp-aliro could not derive a key slot for that key\n");
+        } else {
+            bool added = false;
+            {
+                Lock lock;
+                if (g_endpoint_count < kMaxEndpoints) {
+                    g_endpoints[g_endpoint_count++] = ep;
+                    added = true;
+                }
+            }
+            if (!added) {
+                printf("RING ERROR endpoint table full (%u)\n", static_cast<unsigned>(kMaxEndpoints));
+            } else {
+                (void)StoreEndpoints();
+                PrintHexLine("RING endpoint added, key slot ", ep.slot, ep.slot_len);
+                (void)ReloadReader();
+            }
+        }
+    } else if (strcmp(cmd, "endpoint") == 0 && argc == 4 && strcmp(argv[2], "del") == 0) {
+        uint32_t index = 0;
+        bool removed = false;
+        if (ParseU32(argv[3], 0, kMaxEndpoints - 1, index)) {
+            Lock lock;
+            if (index < g_endpoint_count) {
+                for (size_t i = index; i + 1 < g_endpoint_count; ++i) {
+                    g_endpoints[i] = g_endpoints[i + 1];
+                }
+                --g_endpoint_count;
+                removed = true;
+            }
+        }
+        if (!removed) {
+            printf("RING ERROR no endpoint at that index\n");
+        } else {
+            (void)StoreEndpoints();
+            printf("RING endpoint %" PRIu32 " removed\n", index);
+            (void)ReloadReader();
+        }
+    } else if (strcmp(cmd, "endpoint") == 0 && argc == 3 && strcmp(argv[2], "clear") == 0) {
+        {
+            Lock lock;
+            g_endpoint_count = 0;
+        }
+        (void)StoreEndpoints();
+        printf("RING endpoint keys cleared\n");
+        (void)ReloadReader();
+    } else if (strcmp(cmd, "trust") == 0 && argc == 3 &&
+               (strcmp(argv[2], "list") == 0 || strcmp(argv[2], "any") == 0)) {
+        const Trust trust = strcmp(argv[2], "any") == 0 ? Trust::kAny : Trust::kList;
+        {
+            Lock lock;
+            g_trust = trust;
+        }
+        (void)NvsSetU32(kKeyTrust, trust == Trust::kAny ? 1 : 0);
+        printf("RING trust mode %s\n", argv[2]);
+        (void)ReloadReader();
+#if RING_HAVE_ST25R300
+    } else if (strcmp(cmd, "budget") == 0 && argc == 3) {
+        uint32_t ms = 0;
+        if (!ParseU32(argv[2], 100, 120000, ms)) {
+            printf("RING ERROR usage: ring budget <100..120000 ms>\n");
+        } else {
+            st25r300_set_apdu_budget_ms(ms);
+            PersistDriverKnobs();
+            printf("RING APDU budget %" PRIu32 " ms\n", st25r300_get_apdu_budget_ms());
+        }
+    } else if (strcmp(cmd, "fwt") == 0 && argc == 3) {
+        uint32_t ms = 0;
+        if (!ParseU32(argv[2], 1, 19800, ms)) {
+            printf("RING ERROR usage: ring fwt <1..19800 ms>\n");
+        } else {
+            st25r300_set_fwt_floor_ms(ms);
+            PersistDriverKnobs();
+            printf("RING FWT floor %" PRIu32 " ms\n", st25r300_get_fwt_floor_ms());
+        }
+    } else if (strcmp(cmd, "wtxcap") == 0 && argc == 3) {
+        uint32_t ms = 0;
+        if (!ParseU32(argv[2], 100, 19800, ms)) {
+            printf("RING ERROR usage: ring wtxcap <100..19800 ms>\n");
+        } else {
+            st25r300_set_wtx_ceiling_ms(ms);
+            PersistDriverKnobs();
+            printf("RING WTX ceiling %" PRIu32 " ms\n", st25r300_get_wtx_ceiling_ms());
+        }
+    } else if (strcmp(cmd, "attempts") == 0 && argc == 3) {
+        uint32_t n = 0;
+        if (!ParseU32(argv[2], 1, 5, n)) {
+            printf("RING ERROR usage: ring attempts <1..5>\n");
+        } else {
+            st25r300_set_apdu_attempts(static_cast<uint8_t>(n));
+            PersistDriverKnobs();
+            printf("RING attempts per APDU %u\n", st25r300_get_apdu_attempts());
+        }
+    } else if (strcmp(cmd, "trace") == 0 && argc == 4 && strcmp(argv[2], "frames") == 0) {
+        bool on = false;
+        if (!ParseOnOff(argv[3], on)) {
+            printf("RING ERROR usage: ring trace frames on|off\n");
+        } else {
+            st25r300_set_frame_trace(on);
+            PersistDriverKnobs();
+            printf("RING frame trace %s\n", on ? "on" : "off");
+        }
+#endif
+    } else if (strcmp(cmd, "trace") == 0 && argc == 4 && strcmp(argv[2], "apdu") == 0) {
+        bool on = false;
+        if (!ParseOnOff(argv[3], on)) {
+            printf("RING ERROR usage: ring trace apdu on|off\n");
+        } else {
+            g_apdu_trace = on;
+            PersistDriverKnobs();
+            printf("RING APDU trace %s\n", on ? "on" : "off");
+        }
+    } else if (strcmp(cmd, "reload") == 0) {
+        (void)ReloadReader();
+    } else if (strcmp(cmd, "fastclear") == 0) {
+        esp_aliro_clear_fast_transaction_storage();
+        printf("RING fast-transaction storage cleared; the next tap runs a standard transaction\n");
+    } else {
+        printf("RING ERROR unknown or malformed command; type \"ring help\"\n");
+    }
+    fflush(stdout);
+    return true;
+}
+
+void RingTestSessionBegin()
+{
+    g_session_start_us = esp_timer_get_time();
+    g_step_count = 0;
+    g_steps_dropped = 0;
+    g_transaction_type = "unknown";
+    printf("RING ---- session start ----\n");
+    fflush(stdout);
+}
+
+void RingTestBeforeExchange(const uint8_t *command, size_t command_len)
+{
+    char name[16];
+    FormatStepName(command, command_len, name, sizeof(name));
+    // Printed before the exchange, so a transaction that stalls still says
+    // which command the card is sitting on.
+    printf("RING t=%" PRIu32 " ms > %s CLA=%02X INS=%02X len=%u\n", SinceSessionMs(), name,
+           command_len > 0 ? command[0] : 0, command_len > 1 ? command[1] : 0, static_cast<unsigned>(command_len));
+    if (g_apdu_trace) {
+        PrintHexDump("RING   > ", command, command_len);
+    }
+    fflush(stdout);
+}
+
+void RingTestAfterExchange(const uint8_t *command, size_t command_len, const uint8_t *response,
+                           size_t response_len, esp_err_t err, int64_t elapsed_us)
+{
+    Step step = {};
+    FormatStepName(command, command_len, step.name, sizeof(step.name));
+    step.cla = command_len > 0 ? command[0] : 0;
+    step.ins = command_len > 1 ? command[1] : 0;
+    step.ms = static_cast<uint32_t>(elapsed_us / 1000);
+    step.command_len = command_len;
+    step.response_len = err == ESP_OK ? response_len : 0;
+    step.sw = err == ESP_OK && response_len >= 2
+        ? static_cast<uint16_t>((response[response_len - 2] << 8) | response[response_len - 1])
+        : 0;
+    step.err = err;
+    step.last_frame = "";
+#if RING_HAVE_ST25R300
+    st25r300_apdu_stats_t stats = {};
+    st25r300_get_last_apdu_stats(&stats);
+    step.wtx = stats.wtx;
+    step.budget_exceeded = stats.budget_exceeded;
+    step.wtx_limit = stats.wtx_limit;
+    step.last_frame = stats.last_frame ? stats.last_frame : "";
+#endif
+    if (g_step_count < kMaxSteps) {
+        g_steps[g_step_count++] = step;
+    } else {
+        ++g_steps_dropped;
+    }
+
+    if (err == ESP_OK) {
+        printf("RING t=%" PRIu32 " ms < %s %" PRIu32 " ms, rsp len=%u SW=%04X, WTX=%" PRIu32 "\n", SinceSessionMs(),
+               step.name, step.ms, static_cast<unsigned>(response_len), step.sw, step.wtx);
+        if (g_apdu_trace) {
+            PrintHexDump("RING   < ", response, response_len);
+        }
+    } else {
+        printf("RING t=%" PRIu32 " ms < %s FAILED after %" PRIu32 " ms: %s, WTX=%" PRIu32 ", last frame %s%s%s\n",
+               SinceSessionMs(), step.name, step.ms, esp_err_to_name(err), step.wtx, step.last_frame,
+               step.budget_exceeded ? ", APDU BUDGET EXCEEDED" : "", step.wtx_limit ? ", WTX LIMIT HIT" : "");
+    }
+    fflush(stdout);
+}
+
+void RingTestNoteTransactionType(esp_aliro_session_handle_t session)
+{
+    esp_aliro_transaction_type_t type;
+    if (esp_aliro_session_get_transaction_type(session, &type) == ESP_OK) {
+        g_transaction_type = type == ESP_ALIRO_TRANSACTION_FAST ? "FAST" : "STANDARD";
+    }
+}
+
+void RingTestSessionEnd(esp_err_t err, const char *phase)
+{
+    const uint32_t total_ms = SinceSessionMs();
+    if (err == ESP_OK) {
+        printf("RING ==== RESULT OK in %" PRIu32 " ms (%u APDUs, %s transaction)\n", total_ms,
+               static_cast<unsigned>(g_step_count), g_transaction_type);
+    } else {
+        printf("RING ==== RESULT FAIL in phase %s after %" PRIu32 " ms: %s (%s transaction)\n",
+               phase ? phase : "?", total_ms, esp_err_to_name(err), g_transaction_type);
+    }
+    for (size_t i = 0; i < g_step_count; ++i) {
+        const Step &s = g_steps[i];
+        if (s.err == ESP_OK) {
+            printf("RING   %2u %-13s %7" PRIu32 " ms  SW=%04X  cmd=%u rsp=%u  WTX=%" PRIu32 "\n",
+                   static_cast<unsigned>(i), s.name, s.ms, s.sw, static_cast<unsigned>(s.command_len),
+                   static_cast<unsigned>(s.response_len), s.wtx);
+        } else {
+            printf("RING   %2u %-13s %7" PRIu32 " ms  TRANSPORT FAILED (%s)  WTX=%" PRIu32 "\n",
+                   static_cast<unsigned>(i), s.name, s.ms, esp_err_to_name(s.err), s.wtx);
+        }
+    }
+    if (g_steps_dropped) {
+        printf("RING   (%u further APDUs not listed)\n", static_cast<unsigned>(g_steps_dropped));
+    }
+
+    if (err != ESP_OK) {
+        // Say where it stopped and what to try, from what the transport saw.
+        if (g_step_count == 0) {
+            printf("RING   diagnosis: failed before any APDU (session setup). Is a reader loaded? \"ring show\"\n");
+        } else {
+            const Step &last = g_steps[g_step_count - 1];
+            if (last.err != ESP_OK) {
+                if (last.budget_exceeded) {
+                    printf("RING   diagnosis: %s was still running when the APDU budget ran out. "
+                           "Try \"ring budget 60000\".\n", last.name);
+                } else if (last.wtx_limit) {
+                    printf("RING   diagnosis: %s asked for time more often than the WTX backstop allows.\n",
+                           last.name);
+                } else if (strcmp(last.last_frame, "timeout") == 0 && last.wtx == 0) {
+                    printf("RING   diagnosis: no answer to %s within the frame waiting time and no S(WTX) "
+                           "from the card. If the applet computes without WTX, try \"ring fwt 5000\".\n",
+                           last.name);
+                } else if (strcmp(last.last_frame, "timeout") == 0) {
+                    printf("RING   diagnosis: the card stopped answering during %s after %" PRIu32
+                           " WTX grants: field lost (ring moved?) or the card reset. \"ring trace frames on\" "
+                           "shows the last frames.\n", last.name, last.wtx);
+                } else if (strcmp(last.last_frame, "ok") == 0) {
+                    printf("RING   diagnosis: every frame of %s arrived, but the ISO-DEP exchange did not "
+                           "complete: a response larger than the library buffer, R(NAK), S(DESELECT) or a "
+                           "chaining error. \"ring trace frames on\" shows which.\n", last.name);
+                } else {
+                    printf("RING   diagnosis: RF error during %s (last frame %s). Check coupling and "
+                           "position.\n", last.name, last.last_frame);
+                }
+            } else if (last.sw != 0x9000) {
+                printf("RING   diagnosis: the card answered %s with SW=%04X and esp-aliro stopped there.\n",
+                       last.name, last.sw);
+            } else {
+                printf("RING   diagnosis: %s completed with SW=9000 but esp-aliro rejected its content "
+                       "(see its error line above: signature, key slot, decryption).\n", last.name);
+            }
+        }
+    }
+    fflush(stdout);
+}
+
+#endif // CONFIG_ALIRO_RING_TEST_MODE
